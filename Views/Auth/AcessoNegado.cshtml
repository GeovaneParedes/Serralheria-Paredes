@{
    ViewData["Title"] = "Acesso Negado";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <div class="display-1 text-danger mb-3">⛔</div>
                <h2 class="fw-bold text-danger">Acesso Restrito</h2>
                <p class="lead text-muted">
                    Seu perfil de usuário não possui as permissões necessárias para acessar este recurso.
                </p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 me-2">
                        Página Inicial
                    </a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary">
                            Trocar de Conta
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
