@model IReadOnlyList<UsuarioViewModel>
@{
    ViewData["Title"] = "Gestão de Usuários e Perfis";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">👥 Gestão de Colaboradores e Perfis</h2>
            <p class="text-muted mb-0">Controle de acessos, funções e status dos usuários do sistema.</p>
        </div>
        <a asp-action="NovoUsuario" class="btn btn-primary fw-bold shadow-sm">
            ➕ Novo Colaborador
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            ❌ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Nome Completo</th>
                            <th>E-mail</th>
                            <th>Cargo</th>
                            <th>Perfil de Acesso</th>
                            <th>Data de Cadastro</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    Nenhum usuário cadastrado no momento.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@user.NomeCompleto</td>
                                    <td><code>@user.Email</code></td>
                                    <td>@(string.IsNullOrWhiteSpace(user.Cargo) ? "-" : user.Cargo)</td>
                                    <td>
                                        @switch (user.Perfil)
                                        {
                                            case PerfisConstantes.Administrador:
                                                <span class="badge bg-danger fs-6 px-3 py-2">Administrador</span>
                                                break;
                                            case PerfisConstantes.Serralheiro:
                                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">Serralheiro</span>
                                                break;
                                            case PerfisConstantes.Atendente:
                                                <span class="badge bg-info text-dark fs-6 px-3 py-2">Atendente</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary fs-6 px-3 py-2">@user.Perfil</span>
                                                break;
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Inativo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="AlternarStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <input type="hidden" name="ativo" value="@((!user.IsActive).ToString().ToLower())" />
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Deseja desativar o acesso deste colaborador?');">
                                                    Desativar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-success btn-sm">
                                                    Ativar
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
