@model MovimentacaoEstoqueFormViewModel
@{
    ViewData["Title"] = "Movimentar Estoque";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 720px;">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-1">Movimentar estoque</h2>
            <p class="text-muted mb-4">@Model.InsumoDescricao</p>
            <div class="alert alert-light border">Saldo atual: <strong>@Model.SaldoAtual.ToString("N3") @Model.Unidade</strong></div>

            <form asp-action="Movimentar" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="InsumoId" type="hidden" />
                <input asp-for="InsumoDescricao" type="hidden" />
                <input asp-for="SaldoAtual" type="hidden" />
                <input asp-for="Unidade" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Tipo" class="form-label"></label>
                    <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoMovimentacaoEstoque>()" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Quantidade" class="form-label"></label>
                    <input asp-for="Quantidade" class="form-control" step="0.001" />
                    <span asp-validation-for="Quantidade" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Motivo" class="form-label"></label>
                    <textarea asp-for="Motivo" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Motivo" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button class="btn btn-primary" type="submit">Registrar movimentação</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
