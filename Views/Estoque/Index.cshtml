@model EstoqueIndexViewModel
@{
    ViewData["Title"] = "Estoque e Insumos";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <h2 class="fw-bold mb-1">📦 Estoque e Insumos</h2>
            <p class="text-muted mb-0">Acompanhe saldos e registre entradas e saídas.</p>
        </div>
        <a asp-action="Historico" class="btn btn-outline-dark">Ver histórico</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <form method="get" asp-action="Index" class="input-group mb-4">
        <input name="termo" value="@Model.Termo" class="form-control" placeholder="Buscar por código ou descrição" />
        <button class="btn btn-dark" type="submit">Buscar</button>
    </form>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Insumo</th>
                        <th>Categoria</th>
                        <th>Unidade</th>
                        <th>Saldo</th>
                        <th>Custo unitário</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Insumos.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Nenhum insumo encontrado.</td></tr>
                    }
                    else
                    {
                        @foreach (var insumo in Model.Insumos)
                        {
                            <tr>
                                <td><strong>@insumo.Codigo</strong><br /><span class="text-muted">@insumo.Descricao</span></td>
                                <td>@insumo.Categoria</td>
                                <td>@insumo.Unidade</td>
                                <td>
                                    <span class="@(insumo.EstoqueAbaixoDoMinimo ? "text-danger fw-bold" : "")">@insumo.EstoqueAtual.ToString("N3")</span>
                                    <small class="text-muted d-block">mín. @insumo.EstoqueMinimo.ToString("N3")</small>
                                </td>
                                <td>@insumo.CustoUnitario.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                <td class="text-end">
                                    <a asp-action="Movimentar" asp-route-id="@insumo.Id" class="btn btn-sm btn-primary">Movimentar</a>
                                    <a asp-action="Historico" asp-route-insumoId="@insumo.Id" class="btn btn-sm btn-outline-secondary">Histórico</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Paginacao?.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">Página @Model.Paginacao.Pagina de @Model.Paginacao.TotalPaginas · @Model.Paginacao.Total registro(s)</small>
            <div class="btn-group">
                @if (Model.Paginacao.Pagina > 1) { <a class="btn btn-sm btn-outline-secondary" asp-route-termo="@Model.Termo" asp-route-pagina="@(Model.Paginacao.Pagina - 1)" asp-route-tamanho="@Model.Paginacao.Tamanho">Anterior</a> }
                @if (Model.Paginacao.Pagina < Model.Paginacao.TotalPaginas) { <a class="btn btn-sm btn-outline-secondary" asp-route-termo="@Model.Termo" asp-route-pagina="@(Model.Paginacao.Pagina + 1)" asp-route-tamanho="@Model.Paginacao.Tamanho">Próxima</a> }
            </div>
        </div>
    }
</div>
