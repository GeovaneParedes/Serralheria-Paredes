@model IReadOnlyList<FornecedorViewModel>
@{
    ViewData["Title"] = "Gestão de Fornecedores";
    Layout = "_Layout";
    var termo = ViewBag.TermoBusca as string;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <h2 class="fw-bold mb-1">🏢 Fornecedores de Insumos</h2>
            <p class="text-muted mb-0">Gestão de parceiros comerciais de perfis, tubos, chapas e ferragens.</p>
        </div>
        <div>
            <a asp-action="Novo" class="btn btn-primary fw-bold shadow-sm px-3">
                ➕ Novo Fornecedor
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            ❌ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">🔍</span>
                        <input type="text" name="termo" value="@termo" class="form-control border-start-0" placeholder="Buscar por Razão Social, CNPJ, Representante ou E-mail..." />
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 fw-semibold">Filtrar</button>
                    @if (!string.IsNullOrWhiteSpace(termo))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Razão Social / Fantasia</th>
                            <th>CNPJ / CPF</th>
                            <th>Telefone</th>
                            <th>Representante / Vendedor</th>
                            <th>Localização</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="display-6 mb-2">📭</div>
                                    Nenhum fornecedor encontrado @(!string.IsNullOrWhiteSpace(termo) ? $"para a busca \"{termo}\"" : "no sistema").
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var f in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@f.RazaoSocial</div>
                                        @if (!string.IsNullOrWhiteSpace(f.NomeFantasia))
                                        {
                                            <small class="text-muted">Fantasia: @f.NomeFantasia</small>
                                        }
                                    </td>
                                    <td><code>@f.CpfOuCnpjFormatado</code></td>
                                    <td>@f.Telefone</td>
                                    <td>@(string.IsNullOrWhiteSpace(f.ContatoResponsavel) ? "-" : f.ContatoResponsavel)</td>
                                    <td>@f.Localizacao</td>
                                    <td>
                                        @if (f.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Inativo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Detalhes" asp-route-id="@f.Id" class="btn btn-outline-secondary btn-sm" title="Ver Detalhes">
                                                👁️
                                            </a>
                                            <a asp-action="Editar" asp-route-id="@f.Id" class="btn btn-outline-primary btn-sm" title="Editar">
                                                ✏️
                                            </a>
                                            <form asp-action="AlternarStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@f.Id" />
                                                <input type="hidden" name="ativo" value="@((!f.IsActive).ToString().ToLower())" />
                                                @if (f.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Desativar" onclick="return confirm('Deseja desativar este fornecedor?');">
                                                        🚫
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-outline-success btn-sm" title="Ativar">
                                                        ✅
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
